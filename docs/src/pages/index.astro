---
import "@fontsource-variable/outfit";
import "@fontsource-variable/recursive/full.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Juttu — Comments that live on the open web</title>
    <meta
      name="description"
      content="Juttu is a Bluesky-powered comment widget. Every comment is a real Bluesky post — owned by your readers, not by you, not by us."
    />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <!-- ─── NAVBAR ─────────────────────────────────────────────── -->
    <nav class="navbar" id="navbar">
      <div class="container navbar-inner">
        <a href="/" class="logo" aria-label="Juttu">
          <svg
            height="26"
            viewBox="0 0 904 333"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M90.012,332.763c-19.899,0 -37.388,-3.809 -52.468,-11.426c-11.592,-5.856 -21.669,-13.365 -30.229,-22.529c-4.297,-4.568 -4.083,-11.752 0.479,-16.056c7.495,-7.086 18.83,-17.78 26.658,-25.165c4.494,-4.24 11.551,-4.118 15.896,0.275c3.855,3.881 8.158,7.082 12.905,9.607c7.89,4.197 16.654,6.296 26.292,6.296c9.872,0 18.403,-2.04 25.593,-6.121c7.19,-4.081 12.787,-9.988 16.79,-17.722c4.003,-7.734 6.005,-17.12 6.005,-28.158c0,-0 0,-165.091 0,-210.387c0,-3.018 1.199,-5.911 3.332,-8.045c2.134,-2.134 5.028,-3.332 8.045,-3.332l40.906,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045c-0,44.759 0,206.306 0,206.306c-0,23.164 -4.606,43.373 -13.817,60.63c-9.211,17.256 -22.134,30.645 -38.768,40.167c-16.634,9.522 -36.3,14.283 -58.997,14.283Z"
            ></path>
            <path
              d="M322.613,332.763c-19.729,0 -37.312,-4.236 -52.748,-12.709c-15.437,-8.473 -27.489,-20.172 -36.155,-35.099c-8.667,-14.927 -13,-32.145 -13,-51.655c-0,-0 0,-87.518 0,-119.319c0,-6.284 5.094,-11.378 11.378,-11.378l38.574,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045c0,31.543 -0,117.81 -0,117.81c0,9.337 1.589,17.319 4.766,23.946c3.177,6.627 7.84,11.715 13.988,15.267c6.148,3.551 13.461,5.327 21.938,5.327c12.748,0 22.658,-3.889 29.732,-11.667c7.073,-7.778 10.61,-18.735 10.61,-32.873c0,-0 0,-86.267 0,-117.81c-0,-3.018 1.199,-5.911 3.332,-8.045c2.134,-2.134 5.028,-3.332 8.045,-3.332l38.574,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045c0,31.802 0,119.326 -0,119.326c-0,19.743 -4.314,37.077 -12.942,52.002c-8.628,14.924 -20.588,26.564 -35.879,34.92c-15.291,8.356 -32.947,12.534 -52.967,12.534Z"
            ></path>
            <path
              d="M486.538,327.866c-3.018,0 -5.911,-1.199 -8.045,-3.332c-2.134,-2.134 -3.332,-5.028 -3.332,-8.045l0,-296.017c-0,-3.018 1.199,-5.911 3.332,-8.045c2.134,-2.134 5.028,-3.332 8.045,-3.332l38.574,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045l0,296.017c0,3.018 -1.199,5.911 -3.332,8.045c-2.134,2.134 -5.028,3.332 -8.045,3.332l-38.574,0Zm-112.089,-171.628c-6.284,-0 -11.378,-5.094 -11.378,-11.378l0,-30.879c-0,-6.284 5.094,-11.378 11.378,-11.378l374.838,0c6.284,0 11.378,5.094 11.378,11.378l0,30.879c0,6.284 -5.094,11.378 -11.378,11.378l-374.838,0Zm224.177,171.628c-3.018,0 -5.911,-1.199 -8.045,-3.332c-2.134,-2.134 -3.332,-5.028 -3.332,-8.045l0,-296.017c-0,-3.018 1.199,-5.911 3.332,-8.045c2.134,-2.134 5.028,-3.332 8.045,-3.332l38.574,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045l0,296.017c0,3.018 -1.199,5.911 -3.332,8.045c-2.134,2.134 -5.028,3.332 -8.045,3.332l-38.574,0Z"
            ></path>
            <path
              d="M801.24,332.763c-19.729,0 -37.312,-4.236 -52.748,-12.709c-15.437,-8.473 -27.489,-20.172 -36.155,-35.099c-8.667,-14.927 -13,-32.145 -13,-51.655c0,-0 0,-87.518 0,-119.319c0,-6.284 5.094,-11.378 11.378,-11.378l38.574,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045c0,31.543 0,117.81 0,117.81c0,9.337 1.589,17.319 4.766,23.946c3.177,6.627 7.84,11.715 13.988,15.267c6.148,3.551 13.461,5.327 21.938,5.327c12.748,0 22.658,-3.889 29.732,-11.667c7.073,-7.778 10.61,-18.735 10.61,-32.873c0,-0 0,-86.267 0,-117.81c-0,-3.018 1.199,-5.911 3.332,-8.045c2.134,-2.134 5.028,-3.332 8.045,-3.332l38.574,0c3.018,-0 5.911,1.199 8.045,3.332c2.134,2.134 3.332,5.028 3.332,8.045l0,119.326c-0,19.743 -4.314,37.077 -12.942,52.002c-8.628,14.924 -20.588,26.564 -35.879,34.92c-15.291,8.356 -32.947,12.534 -52.967,12.534Z"
            ></path>
          </svg>
        </a>

        <div class="nav-links">
          <a href="https://juttu.app/why-juttu" class="nav-link"
            >Documentation</a
          >
          <a
            href="https://github.com/matteomarjanovic/juttu"
            class="nav-link"
            target="_blank"
            rel="noopener"
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
              ></path>
            </svg>
            GitHub
          </a>
          <a
            href="https://bsky.app/profile/juttu.app"
            class="nav-link"
            target="_blank"
            rel="noopener"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 568 501"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.462-7.227-3.614-10.608-3.631-7.733-.017-2.875-1.169.506-3.631 7.733-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.89-129.52 80.986-149.071-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.659 0 75.291 0 57.946 0-28.906 76.135-1.612 123.121 33.664Z"
              ></path>
            </svg>
            Bluesky
          </a>
          <a href="/getting-started/installation/" class="btn-primary"
            >Get Started</a
          >
        </div>

        <button class="hamburger" id="hamburger" aria-label="Toggle menu">
          <svg
            id="hamburger-open"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line><line
              x1="3"
              y1="12"
              x2="21"
              y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            id="hamburger-close"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            style="display:none"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="mobile-menu" id="mobile-menu" hidden>
        <a href="https://juttu.app/why-juttu" class="mobile-link"
          >Documentation</a
        >
        <a
          href="https://github.com/matteomarjanovic/juttu"
          class="mobile-link"
          target="_blank"
          rel="noopener">GitHub</a
        >
        <a
          href="https://bsky.app/profile/juttu.app"
          class="mobile-link"
          target="_blank"
          rel="noopener">Bluesky</a
        >
        <div class="mobile-cta">
          <a href="/getting-started/installation/" class="btn-primary btn-full"
            >Get Started</a
          >
        </div>
      </div>
    </nav>

    <!-- ─── HERO ───────────────────────────────────────────────── -->
    <section class="section-hero" id="hero">
      <div class="container hero-inner">
        <div class="hero-text">
          <div class="badge">Built on AT Protocol</div>
          <h1 class="hero-title">
            Comments that live on the <em>open web</em>
          </h1>
          <p class="hero-sub">
            Every comment is a real Bluesky post. Owned by your readers, not by
            you, not by us&nbsp;— forever.
          </p>
          <div class="hero-actions">
            <a href="/getting-started/installation/" class="btn-primary btn-lg"
              >Get Started</a
            >
            <a
              href="https://github.com/matteomarjanovic/juttu"
              class="btn-outline btn-lg"
              target="_blank"
              rel="noopener"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
                ></path>
              </svg>
              View on GitHub
            </a>
          </div>
        </div>

        <!-- MOCK WIDGET PREVIEW -->
        <div class="mock-browser" id="mock-widget">
          <div class="browser-chrome">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
            <span class="browser-url">myblog.com/my-first-post</span>
          </div>

          <div class="blog-excerpt">
            <div class="blog-title">My first blog post</div>
            <div class="blog-body">
              This is my first post with Juttu! Readers can comment using their
              Bluesky accounts, and every comment is a real post on the open
              web.
            </div>
          </div>

          <div class="widget-area">
            <!-- Composer -->
            <div class="composer">
              <div class="comment-header">
                <div
                  class="avatar"
                  style="background-image: url('https://api.dicebear.com/9.x/dylan/svg?seed=sarahyy')"
                >
                </div>
                <div class="commenter-info">
                  <span class="display-name">Sarah</span>
                  <span class="handle">@sarah.bsky.app</span>
                </div>
              </div>
              <textarea
                id="mock-compose"
                class="mock-textarea"
                placeholder="Add a comment..."
                rows="3"></textarea>
              <div class="composer-footer">
                <span class="try-it">✦ Try it out!</span>
                <button id="mock-submit" class="btn-primary btn-sm" disabled
                  >Comment</button
                >
              </div>
            </div>

            <!-- Comment list -->
            <div id="mock-comment-list">
              <div class="comments-heading">
                <span id="comment-count-label" class="comments-count"
                  >2 comments</span
                >
                <span class="sort-label">Most liked</span>
              </div>

              <!-- Comment 1: Alice -->
              <div class="comment" data-id="1">
                <div class="comment-header">
                  <div class="comment-meta">
                    <div
                      class="avatar"
                      style="background-image: url('https://api.dicebear.com/9.x/dylan/svg?seed=ali')"
                    >
                    </div>
                    <div class="commenter-info">
                      <span class="display-name">Alice</span>
                      <span class="handle">@alice.bsky.social</span>
                    </div>
                  </div>
                  <span class="comment-date">2h ago</span>
                </div>
                <div class="comment-body">
                  This is a great post! Really enjoyed reading it.
                </div>
                <div class="comment-actions">
                  <button
                    class="action-btn like-btn"
                    data-liked="false"
                    data-count="7"
                    title="Like"
                  >
                    <svg
                      class="action-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"
                      ></path>
                    </svg>
                    <span class="action-count">7</span>
                  </button>
                  <button
                    class="action-btn repost-btn"
                    data-reposted="false"
                    data-count="2"
                    title="Repost"
                  >
                    <svg
                      class="action-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m17 2 4 4-4 4"></path><path
                        d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path
                        d="m7 22-4-4 4-4"></path><path
                        d="M21 13v1a4 4 0 0 1-4 4H3"></path>
                    </svg>
                    <span class="action-count">2</span>
                  </button>
                  <button
                    class="action-btn reply-btn"
                    data-reply-count="1"
                    title="Reply"
                  >
                    <svg
                      class="action-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"
                      ></path>
                    </svg>
                    <span class="action-count">1</span>
                  </button>
                </div>

                <!-- Nested reply: Carol -->
                <div class="replies">
                  <div class="comment reply-comment" data-id="10">
                    <div class="comment-header">
                      <div class="comment-meta">
                        <div
                          class="avatar avatar-sm"
                          style="background-image: url('https://api.dicebear.com/9.x/dylan/svg?seed=carol')"
                        >
                        </div>
                        <div class="commenter-info">
                          <span class="display-name">Carol</span>
                          <span class="handle">@carol.bsky.social</span>
                        </div>
                      </div>
                      <span class="comment-date">1h ago</span>
                    </div>
                    <div class="comment-body">Totally agree!</div>
                    <div class="comment-actions">
                      <button
                        class="action-btn like-btn"
                        data-liked="false"
                        data-count="3"
                        title="Like"
                      >
                        <svg
                          class="action-icon"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path
                            d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"
                          ></path>
                        </svg>
                        <span class="action-count">3</span>
                      </button>
                      <button
                        class="action-btn repost-btn"
                        data-reposted="false"
                        data-count="0"
                        title="Repost"
                      >
                        <svg
                          class="action-icon"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="m17 2 4 4-4 4"></path><path
                            d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path
                            d="m7 22-4-4 4-4"></path><path
                            d="M21 13v1a4 4 0 0 1-4 4H3"></path>
                        </svg>
                        <span class="action-count">0</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Comment 2: Bob -->
              <div class="comment" data-id="2">
                <div class="comment-header">
                  <div class="comment-meta">
                    <div
                      class="avatar"
                      style="background-image: url('https://api.dicebear.com/9.x/dylan/svg?seed=o')"
                    >
                    </div>
                    <div class="commenter-info">
                      <span class="display-name">Bob</span>
                      <span class="handle">@bob.bsky.social</span>
                    </div>
                  </div>
                  <span class="comment-date">3h ago</span>
                </div>
                <div class="comment-body">
                  Agreed — and the best part is my comment lives on Bluesky too
                  🎉
                </div>
                <div class="comment-actions">
                  <button
                    class="action-btn like-btn"
                    data-liked="false"
                    data-count="12"
                    title="Like"
                  >
                    <svg
                      class="action-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"
                      ></path>
                    </svg>
                    <span class="action-count">12</span>
                  </button>
                  <button
                    class="action-btn repost-btn"
                    data-reposted="false"
                    data-count="3"
                    title="Repost"
                  >
                    <svg
                      class="action-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m17 2 4 4-4 4"></path><path
                        d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path
                        d="m7 22-4-4 4-4"></path><path
                        d="M21 13v1a4 4 0 0 1-4 4H3"></path>
                    </svg>
                    <span class="action-count">3</span>
                  </button>
                  <button
                    class="action-btn reply-btn"
                    data-reply-count="0"
                    title="Reply"
                  >
                    <svg
                      class="action-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"
                      ></path>
                    </svg>
                    <span class="action-count">0</span>
                  </button>
                </div>

                <div class="replies"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── TRUST STRIP ────────────────────────────────────────── -->
    <section class="section-dark section-trust">
      <div class="container trust-inner">
        {
          [
            "AGPLv3 Open Source",
