<script is:inline>
  // ─── Mobile menu ───────────────────────────────────────────────
  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("hamburger-open");
  const iconClose = document.getElementById("hamburger-close");

  hamburger.addEventListener("click", () => {
    const isOpen = !mobileMenu.hidden;
    mobileMenu.hidden = isOpen;
    iconOpen.style.display = isOpen ? "" : "none";
    iconClose.style.display = isOpen ? "none" : "";
  });

  // ─── Mock widget ───────────────────────────────────────────────
  let nextId = 100;
  let mockCount = 2; // initial top-level comment count

  function updateCount() {
    document.getElementById("comment-count-label").textContent =
      mockCount + " comment" + (mockCount !== 1 ? "s" : "");
  }

  // Like / Repost toggle
  document.querySelectorAll(".like-btn, .repost-btn").forEach((btn) => {
    const isLike = btn.classList.contains("like-btn");
    const activeColor = isLike ? "#e0245e" : "#17bf63";
    const svg = btn.querySelector("svg");
    const countEl = btn.querySelector(".action-count");

    btn.addEventListener("click", () => {
      const active =
        btn.dataset.liked === "true" || btn.dataset.reposted === "true";
      const newCount = parseInt(countEl.textContent) + (active ? -1 : 1);
      countEl.textContent = newCount;

      if (isLike) {
        btn.dataset.liked = (!active).toString();
        svg.style.stroke = active ? "" : activeColor;
        svg.style.fill = active ? "none" : activeColor;
        countEl.style.color = active ? "" : activeColor;
      } else {
        btn.dataset.reposted = (!active).toString();
        svg.style.stroke = active ? "" : activeColor;
        countEl.style.color = active ? "" : activeColor;
      }
    });
  });

  function buildComment(text) {
    const id = nextId++;
    const div = document.createElement("div");
    div.className = "comment";
    div.dataset.id = id;
    div.innerHTML = `
      <div class="comment-header">
        <div class="comment-meta">
          <div class="avatar" style="background-image: url('https://api.dicebear.com/9.x/dylan/svg?seed=sarahyy')"></div>
          <div class="commenter-info">
            <span class="display-name">Sarah</span>
            <span class="handle">@sarah.bsky.app</span>
          </div>
        </div>
        <span class="comment-date">just now</span>
      </div>
      <div class="comment-body">${text.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</div>
      <div class="comment-actions">
        <button class="action-btn like-btn" data-liked="false" data-count="0" title="Like">
          <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>
          </svg>
          <span class="action-count">0</span>
        </button>
        <button class="action-btn repost-btn" data-reposted="false" data-count="0" title="Repost">
          <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>
          </svg>
          <span class="action-count">0</span>
        </button>
        <button class="action-btn reply-btn" data-reply-count="0" title="Reply">
          <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="action-count">0</span>
        </button>
      </div>
      <div class="replies"></div>`;

    // Wire up like/repost
    div.querySelectorAll(".like-btn, .repost-btn").forEach((b) => {
      const isLike = b.classList.contains("like-btn");
      const activeColor = isLike ? "#e0245e" : "#17bf63";
      const svg = b.querySelector("svg");
      const countEl = b.querySelector(".action-count");
      b.addEventListener("click", () => {
        const active =
          b.dataset.liked === "true" || b.dataset.reposted === "true";
        const newCount = parseInt(countEl.textContent) + (active ? -1 : 1);
        countEl.textContent = newCount;
        if (isLike) {
          b.dataset.liked = (!active).toString();
          svg.style.stroke = active ? "" : activeColor;
          svg.style.fill = active ? "none" : activeColor;
          countEl.style.color = active ? "" : activeColor;
        } else {
          b.dataset.reposted = (!active).toString();
          svg.style.stroke = active ? "" : activeColor;
          countEl.style.color = active ? "" : activeColor;
        }
      });
    });

    return div;
  }

  // Main compose
  const composeTA = document.getElementById("mock-compose");
  const composeSubmit = document.getElementById("mock-submit");
  const commentList = document.getElementById("mock-comment-list");
  const commentsHeading = commentList.querySelector(".comments-heading");

  composeTA.addEventListener("input", () => {
    composeSubmit.disabled = !composeTA.value.trim();
  });

  composeSubmit.addEventListener("click", () => {
    const text = composeTA.value.trim();
    if (!text) return;
    const newComment = buildComment(text);
    commentsHeading.insertAdjacentElement("afterend", newComment);
    mockCount++;
    updateCount();
    composeTA.value = "";
    composeSubmit.disabled = true;
  });
</script>

