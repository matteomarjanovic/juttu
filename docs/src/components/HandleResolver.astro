---

---

<div class="not-content my-4 mb-6">
  <div class="flex gap-2 flex-wrap items-center">
    <div class="relative flex-[1_1_200px] min-w-0">
      <input
        id="hr-input"
        type="text"
        placeholder="your-handle.bsky.social"
        autocomplete="off"
        spellcheck="false"
        class="hr-input w-full px-2.5 py-1.5 text-sm font-mono rounded"
      />
      <ul
        id="hr-suggestions"
        hidden
        class="hr-suggestions absolute top-full left-0 right-0 z-10 mt-0.5 p-0 m-0 list-none rounded shadow-md"
      >
      </ul>
    </div>
    <button
      id="hr-btn"
      type="button"
      class="hr-btn px-4 py-1.5 text-sm rounded cursor-pointer whitespace-nowrap"
      >Look up DID</button
    >
  </div>
  <p id="hr-error" class="hr-error mt-2 text-sm" hidden></p>
  <div id="hr-result" class="mt-3" hidden>
    <p class="hr-label mb-1.5 text-sm">
      Your personalised <code>&lt;link&gt;</code> tag:
    </p>
    <div class="flex items-stretch rounded overflow-hidden hr-code-row">
      <pre
        id="hr-output"
        class="hr-pre flex-1 m-0 px-3 py-2 text-xs font-mono whitespace-pre overflow-x-auto">
      </pre>
      <button
        id="hr-copy"
        type="button"
        class="hr-copy px-3.5 shrink-0 text-xs cursor-pointer whitespace-nowrap"
        >Copy</button
      >
    </div>
  </div>
</div>

<style is:global>
  .hr-input {
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  .hr-input:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  .hr-btn {
    border: none;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
  }
  .hr-btn:hover:not(:disabled) {
    background: var(--sl-color-gray-4);
  }
  .hr-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .hr-suggestions {
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg);
  }
  .hr-suggestions li {
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-family: var(--sl-font-mono);
    color: var(--sl-color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hr-suggestions li:hover,
  .hr-suggestions li.hr-active {
    background: var(--sl-color-accent-low);
  }
  .hr-error {
    color: var(--sl-color-red);
  }
  .hr-label {
    color: var(--sl-color-text-accent);
  }
  .hr-code-row {
    border: 1px solid var(--sl-color-gray-4);
  }
  .hr-pre {
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-text);
  }
  .hr-copy {
    border: none;
    border-left: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
  }
  .hr-copy:hover {
    background: var(--sl-color-gray-6);
  }
</style>

<script>
  const input = document.getElementById("hr-input") as HTMLInputElement;
  const btn = document.getElementById("hr-btn") as HTMLButtonElement;
  const error = document.getElementById("hr-error") as HTMLParagraphElement;
  const result = document.getElementById("hr-result") as HTMLDivElement;
  const output = document.getElementById("hr-output") as HTMLPreElement;
  const copyBtn = document.getElementById("hr-copy") as HTMLButtonElement;
  const suggestions = document.getElementById(
    "hr-suggestions",
  ) as HTMLUListElement;

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  let activeIndex = -1;
  let abortController: AbortController | undefined;

  const TID_ALPHABET = "234567abcdefghijklmnopqrstuvwxyz";

  function createTid() {
    let value = ((BigInt(Date.now()) * 1000n) & 0x1fffffffffffffn) << 10n;
    let tid = "";

    for (let i = 0; i < 13; i += 1) {
      tid = TID_ALPHABET[Number(value & 0x1fn)] + tid;
      value >>= 5n;
    }

    return tid;
  }

  function closeSuggestions() {
    suggestions.hidden = true;
    activeIndex = -1;
  }

  function setActive(index: number) {
    const items = suggestions.querySelectorAll("li");
    items.forEach((li, i) => li.classList.toggle("hr-active", i === index));
    activeIndex = index;
  }

  function selectSuggestion(handle: string) {
    input.value = handle;
    closeSuggestions();
    btn.click();
  }

  function renderSuggestions(
    actors: { handle: string; displayName?: string }[],
  ) {
    suggestions.innerHTML = "";
    if (actors.length === 0) {
      closeSuggestions();
      return;
    }
    for (const actor of actors) {
      const li = document.createElement("li");
      const showName = actor.displayName && actor.displayName !== actor.handle;
      li.textContent = showName
        ? `@${actor.handle} · ${actor.displayName}`
        : `@${actor.handle}`;
      li.addEventListener("mousedown", (e) => {
        e.preventDefault();
        selectSuggestion(actor.handle);
      });
      suggestions.appendChild(li);
    }
    activeIndex = -1;
    suggestions.hidden = false;
  }

  async function fetchSuggestions(query: string) {
    abortController?.abort();
    abortController = new AbortController();
    try {
      const url = `https://public.api.bsky.app/xrpc/app.bsky.actor.searchActorsTypeahead?q=${encodeURIComponent(query)}&limit=5`;
      const res = await fetch(url, { signal: abortController.signal });
      if (!res.ok) return;
      const data = (await res.json()) as {
        actors: { handle: string; displayName?: string }[];
      };
      renderSuggestions(data.actors ?? []);
    } catch (err) {
      if (err instanceof Error && err.name === "AbortError") return;
      closeSuggestions();
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    const query = input.value.trim();
    if (query.length < 2) {
      closeSuggestions();
      return;
    }
    debounceTimer = setTimeout(() => fetchSuggestions(query), 300);
  });

  input.addEventListener("keydown", (e) => {
    const items = suggestions.querySelectorAll("li");
    if (!suggestions.hidden && items.length > 0) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(Math.min(activeIndex + 1, items.length - 1));
        return;
      }
      if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(Math.max(activeIndex - 1, 0));
        return;
      }
      if (e.key === "Enter" && activeIndex >= 0) {
        e.preventDefault();
        const handle = (items[activeIndex].textContent ?? "")
          .replace(/^@/, "")
          .split(" · ")[0];
        selectSuggestion(handle);
        return;
      }
      if (e.key === "Escape") {
        closeSuggestions();
        return;
      }
    }
    if (e.key === "Enter") btn.click();
  });

  input.addEventListener("blur", () => {
    setTimeout(closeSuggestions, 150);
  });

  document.addEventListener("click", (e) => {
    if (!suggestions.contains(e.target as Node) && e.target !== input) {
      closeSuggestions();
    }
  });

  btn.addEventListener("click", async () => {
    closeSuggestions();
    const handle = input.value.trim();
    if (!handle) return;

    error.hidden = true;
    result.hidden = true;
    btn.disabled = true;
    btn.textContent = "Looking up…";

    try {
      const url = `https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=${encodeURIComponent(handle)}`;
      const res = await fetch(url);
      if (!res.ok) {
        const text = await res.text().catch(() => "");
        const msg =
          text.includes("InvalidHandle") || text.includes("not found")
            ? "Handle not found. Check spelling and try again."
            : `Could not reach Bluesky (HTTP ${res.status}).`;
        throw new Error(msg);
      }
      const data = (await res.json()) as { did: string };
      const snippet = `<link rel="site.standard.document" href="at://${data.did}/site.standard.document/${createTid()}" />`;
      output.textContent = snippet;
      result.hidden = false;
    } catch (err: unknown) {
      const msg =
        err instanceof Error
          ? err.message
          : "Could not reach Bluesky. Check your connection.";
      error.textContent = msg;
      error.hidden = false;
    } finally {
      btn.disabled = false;
      btn.textContent = "Look up DID";
    }
  });

  copyBtn.addEventListener("click", async () => {
    const text = output.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = "Copied!";
      setTimeout(() => {
        copyBtn.textContent = "Copy";
      }, 1500);
    } catch {
      copyBtn.textContent = "Copy";
    }
  });
</script>
