{
	"name": "juttu-new",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prebuild": "svelte-kit sync && node scripts/generate-oauth-metadata.js && lex build --lexicons ./lexicons --out ./src/lib/lexicons && node scripts/build-embed.js",
		"predev": "svelte-kit sync && node scripts/generate-oauth-metadata.js && lex build --lexicons ./lexicons --out ./src/lib/lexicons --override --clear && node scripts/build-embed.js",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^25.3.5",
		"@vitest/coverage-v8": "^4.0.18",
		"daisyui": "^5.5.14",
		"dotenv": "^17.2.3",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^17.4.0",
		"jsdom": "^28.1.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@atproto/api": "^0.19.3",
		"@atproto/lex": "^0.0.20",
		"@fontsource-variable/outfit": "^5.2.8",
		"@fontsource-variable/recursive": "^5.2.8",
		"@juttu/oauth-client-browser": "^0.3.41"
	}
}
